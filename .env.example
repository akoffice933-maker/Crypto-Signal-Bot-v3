TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_CHANNEL_LINK=https://t.me/your_channel
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret
TESTNET=true
DB_PATH=data/signals.db
LOG_LEVEL=INFO
ACCOUNT_BALANCE=10000

# Multi-pair support (comma-separated)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT

# API Security (REQUIRED for production!)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change_this_in_production

# Dev Mode (set to 'true' for local development ONLY - disables auth!)
# WARNING: Never use DEV_MODE=true on production VPS!
DEV_MODE=false
